<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AudioSwitcher.ViewModels"
        xmlns:models="using:AudioSwitcher.Models"
        x:Class="AudioSwitcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1040" Height="700" MinWidth="880" MinHeight="620"
        Background="#0D1117" FontFamily="Segoe UI Variable Text"
        Icon="/Assets/avalonia-logo.ico"
        Title="AudioSwitcher">

    <Window.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#66E3C4"/>
            <Setter Property="LetterSpacing" Value="1.6"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8D98A8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#151B23"/>
            <Setter Property="BorderBrush" Value="#27313E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#66E3C4"/>
            <Setter Property="Foreground" Value="#07120F"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="#FF8A91"/>
        </Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="30,24,30,18" BorderBrush="#27313E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="eyebrow" Text="WINDOWS AUDIO ROUTING"/>
                    <TextBlock Classes="h1" Text="AudioSwitcher"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshDevicesCommand}" Content="Geräte aktualisieren"
                            ToolTip.Tip="Verfügbare Windows-Audiogeräte neu einlesen"/>
                    <Button Classes="primary" Command="{Binding SaveCommand}" Content="Speichern"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <Border Grid.Column="0" Padding="20" Background="#10151C" BorderBrush="#27313E" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Profile" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding AddProfileCommand}" Content="＋" Padding="10,5"
                                ToolTip.Tip="Profil hinzufügen"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioProfile">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#66E3C4" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hotkey, FallbackValue=Kein Shortcut}" FontSize="11" Foreground="#8D98A8"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Classes="danger" Command="{Binding DeleteProfileCommand}" Content="Profil entfernen"
                            HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="30" Spacing="18" MaxWidth="720">
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="eyebrow" Text="PROFIL"/>
                                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="Gerätekombination"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Command="{Binding ActivateSelectedProfileCommand}"
                                        Content="Jetzt aktivieren" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel>
                                <TextBlock Classes="label" Text="Name"/>
                                <TextBox Text="{Binding SelectedProfile.Name, Mode=TwoWay}" Watermark="z. B. Headset"
                                         AutomationProperties.Name="Profilname"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="Ausgabe"/>
                                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                              AutomationProperties.Name="Ausgabegerät">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AudioDeviceInfo">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="label" Text="Eingabe"/>
                                    <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                                              AutomationProperties.Name="Eingabegerät">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AudioDeviceInfo">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <TextBlock Classes="label" Text="Globaler Shortcut für dieses Profil"/>
                                <TextBox Text="{Binding SelectedProfile.Hotkey, Mode=TwoWay}" Watermark="Ctrl+Alt+1"
                                         AutomationProperties.Name="Profil-Shortcut"/>
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#687587"
                                           Text="Erlaubt: Ctrl/Strg, Alt, Shift, Win + Buchstabe, Zahl oder F1–F24"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Classes="eyebrow" Text="SCHNELLWECHSEL"/>
                                <TextBlock FontSize="21" FontWeight="SemiBold" Text="Zwischen zwei Profilen wechseln"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ToggleProfileA}"
                                          AutomationProperties.Name="Erstes Wechselprofil"/>
                                <TextBlock Grid.Column="1" Text="⇄" FontSize="22" Foreground="#66E3C4" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ToggleProfileB}"
                                          AutomationProperties.Name="Zweites Wechselprofil"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Classes="label" Text="Wechsel-Shortcut"/>
                                <TextBox Text="{Binding ToggleHotkey, Mode=TwoWay}" Watermark="Ctrl+Alt+Space"
                                         AutomationProperties.Name="Wechsel-Shortcut"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="9">
                            <TextBlock Classes="eyebrow" Text="SYSTEM"/>
                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="Mit Windows starten"
                                      AutomationProperties.Name="Mit Windows starten"/>
                            <TextBlock FontSize="11" Foreground="#687587"
                                       Text="Schließen blendet das Fenster aus. Beenden ist über das Tray-Menü möglich."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="30,11" Background="#10151C" BorderBrush="#27313E" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="7" Height="7" CornerRadius="4" Background="#66E3C4" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#AEB8C5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
